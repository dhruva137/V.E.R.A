# Copy to .env. Offline-first defaults: nothing here needs a network or a key.

# Local LLM via Ollama. qwen3:1.7b is fast on a laptop. Thinking must stay off:
# small Ollama models reject the "thinking" parameter with a 400, which silently
# breaks every agent call.
VERA_LLM_PROVIDER=ollama
VERA_LLM_BASE_URL=http://localhost:11434
VERA_LLM_MODEL=qwen3:1.7b
VERA_LLM_THINKING=0
VERA_LLM_API_KEY=

# Demo estate loaded at boot: the synthetic 89-asset key vault.
VERA_AUTOLOAD_VAULT=1
VERA_AUTOLOAD_DEMO=0

# DST persona. For the NTRO demo use CII. Valid values are in backend/engine/regulatory.py:
# CII, Technology Provider, Banking, E-Governance, Insurance, Healthcare, Education, General Enterprise
VERA_ORG_PERSONA=CII

# Engine settings (see docs/ARCHITECTURE.md). Defaults shown.
# VERA_OFFLINE=1           # hard-block outbound network except explicit scan targets
# VERA_PROFILE=commercial  # commercial | cnsa
